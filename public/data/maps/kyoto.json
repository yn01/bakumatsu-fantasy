": "left", "dialogue": ["物騒な世の中に\nなりましたなあ。", "新選組が巡回\nしておりますぞ。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_geisha", "name": "舞妓", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 40, "y": 18}, "direction": "down", "dialogue": ["おこしやす。\n京都へようこそ。", "最近は剣呑な\nお方が多うて……"], "movementPattern": "stationary"}, {"id": "npc_kyoto_monk", "name": "僧侶", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 50, "y": 8}, "direction": "left", "dialogue": ["南無阿弥陀仏……", "この世の争いは\nいつ終わるのでしょうか。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_samurai1", "name": "薩摩藩士", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 10, "y": 30}, "direction": "right", "dialogue": ["西郷どんの言う通り\nじゃっど。", "薩長同盟が成れば\n天下は動く！"], "movementPattern": "stationary"}, {"id": "npc_kyoto_samurai2", "name": "長州藩士", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 30, "y": 37}, "direction": "left", "dialogue": ["木戸さんが京に\nおられると聞いた。", "長州の復権のためには\n薩摩との連携が必要じゃ。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_spy", "name": "怪しい男", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 45, "y": 42}, "direction": "down", "dialogue": ["……何の用だ。", "余計なことを\n嗅ぎ回るな。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_innkeeper", "name": "宿屋の主人", "sprite": "/assets/sprites/characters/npc_merchant.png", "position": {"x": 20, "y": 25}, "direction": "down", "dialogue": ["お泊まりですかい？", "最近は志士の方が\nよく来はります。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_guard1", "name": "新選組・隊士", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 35, "y": 12}, "direction": "down", "dialogue": ["我々は京の治安を\n守る新選組だ。", "不逞浪士は\n容赦せんぞ！"], "movementPattern": "stationary"}, {"id": "npc_kyoto_child", "name": "町の子供", "sprite": "/assets/sprites/characters/npc_villager.png", "position": {"x": 48, "y": 30}, "direction": "left", "dialogue": ["新選組ってこわーい！", "でもお侍さんは\nかっこいいなあ。"], "movementPattern": "stationary"}, {"id": "npc_kyoto_weapon_shop", "name": "鍛冶師", "sprite": "/assets/sprites/characters/npc_merchant.png", "position": {"x": 12, "y": 18}, "direction": "down", "dialogue": "京で一番の業物を揃えてるぜ。", "movementPattern": "stationary", "eventId": "shop_kyoto_weapon"}, {"id": "npc_kyoto_armor_shop", "name": "甲冑師", "sprite": "/assets/sprites/characters/npc_merchant.png", "position": {"x": 28, "y": 18}, "direction": "down", "dialogue": "上質な防具を取り揃えております。", "movementPattern": "stationary", "eventId": "shop_kyoto_armor"}, {"id": "npc_kyoto_black_market", "name": "闇商人", "sprite": "/assets/sprites/characters/npc_merchant.png", "position": {"x": 45, "y": 40}, "direction": "down", "dialogue": "...何も聞くな。買うなら買え。", "movementPattern": "stationary", "eventId": "shop_kyoto_black_market"}], "transitions": [{"id": "to_kobe_port", "fromPosition": {"x": 0, "y": 25}, "toMapId": "kobe_port", "toPosition": {"x": 43, "y": 17}, "direction": "left", "transitionType": "walk"}, {"id": "to_omiya", "fromPosition": {"x": 59, "y": 25}, "toMapId": "omiya", "toPosition": {"x": 1, "y": 7}, "direction": "right", "transitionType": "walk"}, {"id": "to_hidden_dungeon", "fromPosition": {"x": 55, "y": 45}, "toMapId": "hidden_dungeon", "toPosition": {"x": 2, "y": 2}, "direction": "down", "transitionType": "walk", "requiredFlag": "final_chapter_complete"}], "shops": [{"id": "kyoto_weapon_shop", "name": "京の鍛冶屋", "position": {"x": 9, "y": 14}, "items": ["katana", "tachi", "naginata", "meito_muramasa"]}, {"id": "kyoto_armor_shop", "name": "京の防具屋", "position": {"x": 25, "y": 14}, "items": ["haori", "light_armor", "yoroi"]}, {"id": "kyoto_item_shop", "name": "京の薬屋", "position": {"x": 40, "y": 14}, "items": ["kusuri", "iyaku", "kouyaku", "manju", "gedokuyaku"]}], "events": []}